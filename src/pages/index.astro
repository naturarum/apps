---
// Home: the news. One sentence, a filter, the newest post as a lead, then everything by date.
import Base from '../layouts/Base.astro';
import Led from '../components/Led.astro';
import Stage from '../components/Stage.astro';
import PostRow from '../components/PostRow.astro';
import { SITE } from '../data/site';
import { allPosts, appOf, fmtDate, KIND_LABEL, type Kind } from '../lib/news';

const posts = allPosts();
const [lead, ...rest] = posts;
const leadApp = appOf(lead);
const kinds = (Object.keys(KIND_LABEL) as Kind[]).filter((k) => posts.some((p) => p.kind === k));
const tag = SITE.tagline.replace(/(covers)/, '<em class="s">$1</em>');
const leadVisual = leadApp?.film ?? leadApp?.thumb;
---
<Base section="news" crumbs={[{ label: 'News' }]}>
  <Fragment slot="folio">{posts.length} posts<span class="sep">·</span>Updated {fmtDate(lead.date)}<span class="sep">·</span><a href="/news/feed.xml">RSS</a></Fragment>

  <h1 class="t-title" set:html={SITE.tagline.includes('covers') ? tag : SITE.tagline}></h1>

  <div class="filters" role="group" aria-label="Show">
    <button type="button" data-f="all" aria-pressed="true">Everything</button>
    {kinds.map((k) => <button type="button" data-f={k} aria-pressed="false">{KIND_LABEL[k]}</button>)}
  </div>

  <a class="lead-post" href={lead.href} data-k={lead.kind} style={leadApp ? `--a: ${leadApp.accent}` : undefined}>
    <div>
      <p class="mono"><span class="k">{lead.tag}</span><span class="sep"> · </span>{fmtDate(lead.date)}{leadApp && <><span class="sep"> · </span><span class="app">{!leadApp.external && <Led status={leadApp.status} accent={leadApp.accent} />}{leadApp.name}</span></>}</p>
      <h2>{lead.title}</h2>
      <p>{lead.excerpt}</p>
      <span class="more">Read the post <span class="go">&rarr;</span></span>
    </div>
    {leadApp && leadVisual && <Stage visual={leadVisual} accent={leadApp.accent} marks eager cap={leadApp.status === 'dev' ? 'Work in progress' : undefined} />}
  </a>

  <ul class="feed">
    {rest.map((p) => <PostRow post={p} />)}
  </ul>
  <p class="follow">Follow in any reader: <a href="/news/feed.xml"><code>/news/feed.xml</code></a></p>
</Base>

<style>
  .filters { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 28px; }
  .filters button { appearance: none; border: 1px solid var(--line-2); background: transparent; color: var(--dim); font: 500 13px/1 var(--f-sans); padding: 8px 13px; border-radius: 999px; cursor: pointer; }
  .filters button:hover { color: var(--ink); border-color: var(--line-3); }
  .filters button[aria-pressed="true"] { background: var(--hl); border-color: var(--hl); color: var(--on-hl); }
  .lead-post { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 34px; align-items: center; margin-top: 28px; padding-top: 26px; border-top: 1px solid var(--line-2); text-decoration: none; }
  .lead-post[hidden] { display: none; }
  .lead-post h2 { margin: 12px 0 0; font-weight: 500; font-size: 27px; line-height: 1.18; letter-spacing: -0.028em; text-wrap: balance; }
  .lead-post p:not(.mono) { margin: 12px 0 0; color: var(--dim); max-width: 32em; }
  .lead-post .more { display: inline-flex; gap: 8px; margin-top: 18px; font-size: 14.5px; font-weight: 500; }
  .lead-post :global(.stage) { height: 330px; }
  .lead-post:hover h2 { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; text-decoration-color: var(--hl); }
  .k { color: var(--hl); }
  .app { display: inline-flex; gap: 7px; align-items: center; }
  .feed { list-style: none; margin: 40px 0 0; padding: 0; }
  .follow { margin-top: 22px; font-size: 14.5px; color: var(--dim); }
  .follow code { font-family: var(--f-mono); font-size: 12.5px; color: var(--ink); background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 5px 8px; }
  .follow a { text-decoration: none; }
  @media (max-width: 1000px) { .lead-post { grid-template-columns: 1fr; gap: 20px; } .lead-post :global(.stage) { height: 260px; } }
</style>

<script>
  // Filter the feed by kind; the lead post counts as one of the entries.
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button');
  const lead = document.querySelector<HTMLElement>('.lead-post');
  buttons.forEach((b) => b.addEventListener('click', () => {
    const f = b.dataset.f;
    buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    document.querySelectorAll<HTMLElement>('.feed li').forEach((li) => { li.hidden = !(f === 'all' || li.dataset.k === f); });
    if (lead) lead.hidden = !(f === 'all' || lead.dataset.k === f);
  }));
</script>
