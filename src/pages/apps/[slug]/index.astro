---
// A product page. One order for every app: film, name and specs, the idea, the panel, three
// points, screenshots, the manual, coverage, news, questions. Sections an app has no content
// for are left out.
import Base from '../../../layouts/Base.astro';
import Led from '../../../components/Led.astro';
import Stage from '../../../components/Stage.astro';
import { APPS, STATUS_LABEL, type App } from '../../../data/apps';
import { postsFor, fmtDate } from '../../../lib/news';

export function getStaticPaths() {
  return APPS.filter((a) => !a.external).map((app) => ({ params: { slug: app.slug }, props: { app } }));
}
interface Props { app: App }
const { app } = Astro.props;
const posts = postsFor(app.slug);
const manualBase = `/apps/${app.slug}/manual/`;
---
<Base title={app.name} description={app.line} section="apps" crumbs={[{ label: 'Apps', href: '/apps/' }, { label: app.name }]} image={app.icon} accent={app.accent} accentLight={app.accentLight}>
  <Fragment slot="folio"><span class="st"><Led status={app.status} accent={app.accent} />{STATUS_LABEL[app.status]}</span>{posts[0] && <><span class="sep">·</span>Updated {fmtDate(posts[0].date)}</>}</Fragment>

  {app.film && (
    <figure class="film">
      <Stage visual={app.film} accent={app.accent} marks eager class="film-stage">
        {app.film.video && <a class="play" href={app.film.video.href} rel="noopener"><i aria-hidden="true"></i><span>{app.film.video.label}<small>YouTube</small></span></a>}
      </Stage>
      {app.film.caption && <figcaption>{app.film.caption}</figcaption>}
    </figure>
  )}

  <div class="head">
    <div>
      <p class="mono kind"><Led status={app.status} accent={app.accent} />{app.kind} · {STATUS_LABEL[app.status]}</p>
      <h1>{app.name}</h1>
      <p class="lede">{app.line}</p>
    </div>
    <div>
      <div class="btns buy">
        {app.store && <a class="btn" href={app.store} rel="noopener">App Store</a>}
        {app.cta && <a class="btn" href={app.cta.href}>{app.cta.label}</a>}
        {app.manual && <a class="btn ghost" href="#manual">Manual</a>}
        {app.privacy && <a class="btn ghost" href={`/apps/${app.slug}/privacy.html`}>Privacy</a>}
      </div>
      {app.specs && (
        <dl class="spec">
          {app.specs.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}
        </dl>
      )}
    </div>
  </div>

  {app.statement && (
    <section class="sec">
      <p class="statement" set:html={app.statement}></p>
      {app.paragraphs && <div class="two">{app.paragraphs.map((p) => <p>{p}</p>)}</div>}
    </section>
  )}

  {app.panel && (
    <section class="sec">
      <div class="sec-head"><h2 class="t-sec">{app.panel.title}</h2><p>{app.panel.intro}</p></div>
      <div class:list={['panel-list', `n${Math.min(app.panel.groups.length, 3)}`]}>
        {app.panel.groups.map((g) => (
          <div class="col">
            <h3>{g.title}</h3>
            <dl>
              {g.items.map((it) => (
                <div class:list={[!it.gloss && 'solo']}><dt>{it.dot && <i style={`--f: ${it.dot}`}></i>}{it.name}</dt>{it.gloss && <dd>{it.gloss}</dd>}</div>
              ))}
            </dl>
          </div>
        ))}
      </div>
    </section>
  )}

  {app.points && (
    <section class="sec">
      <ul class="points">
        {app.points.map((p, i) => <li><span class="mono">{String(i + 1).padStart(2, '0')}</span><b>{p.title}</b><p>{p.text}</p></li>)}
      </ul>
    </section>
  )}

  {app.slug === 'hexatone' && (
    <section class="sec">
      <a class="tool" href="/tools/sfz-builder/">
        <div><p class="mono">Free companion tool</p><h2 class="t-sec">SFZ Builder</h2><p>Turn a folder of samples into a Hexatone instrument, right in your browser. Pitch is detected for you, nothing is uploaded.</p></div>
        <span class="btn ghost">Open the builder <span class="go">&rarr;</span></span>
      </a>
    </section>
  )}

  {app.shots && (
    <section class="sec">
      <div class:list={['shots', `c${app.shots.length}`]}>
        {app.shots.map((s) => (
          <figure><Stage visual={{ kind: 'device', src: s.src, alt: s.alt, ar: 0.75 }} accent={app.accent} /><figcaption>{s.caption}</figcaption></figure>
        ))}
      </div>
    </section>
  )}

  {app.manual && (
    <section class="sec" id="manual">
      <div class="sec-head"><h2 class="t-sec">The manual</h2><p>{app.manual.chapters.length} chapters, on the web and as a PDF.</p></div>
      <div class="manual">
        <ol class="chapters">{app.manual.chapters.map((c, i) => <li><span class="mono">{String(i + 1).padStart(2, '0')}</span>{c}</li>)}</ol>
        <div class="manual-card">
          <p class="mono">Read it your way</p>
          <p>On the web, or as a PDF{app.manual.pdfDark ? ' in a light or a dark edition' : ''} for the iPad next to the {app.kind.toLowerCase().includes('synth') ? 'synth' : 'app'}.</p>
          <div class="btns">
            <a class="btn" href={manualBase}>Read online</a>
            <a class="btn ghost" href={`${manualBase}manual.pdf`}>PDF</a>
            {app.manual.pdfDark && <a class="btn ghost" href={`${manualBase}manual-dark.pdf`}>PDF, dark</a>}
          </div>
        </div>
      </div>
    </section>
  )}

  {app.seen && (
    <section class="sec" id="seen">
      <div class="sec-head"><h2 class="t-sec">Seen on</h2><p>Videos other people made about {app.name}.</p></div>
      <ul class="rows">
        {app.seen.map((s) => <li><a class="r" href={s.href} rel="noopener"><span class="mono">{fmtDate(s.date)}</span><b>{s.who}</b><span class="mono">YouTube ↗</span></a></li>)}
      </ul>
    </section>
  )}

  {posts.length > 0 && (
    <section class="sec">
      <div class="sec-head"><h2 class="t-sec">News</h2><p>Releases and notes about {app.name}, newest first.</p></div>
      <ul class="rows">
        {posts.map((p) => <li><a class="r" href={p.href}><span class="mono">{fmtDate(p.date)}</span><b>{p.title}</b><span class="go">&rarr;</span></a></li>)}
      </ul>
    </section>
  )}

  {app.faq && (
    <section class="sec">
      <div class="sec-head"><h2 class="t-sec">{app.status === 'out' ? 'Before you buy' : 'Questions'}</h2><p>What people ask first.</p></div>
      {app.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </section>
  )}

  <div class="end">
    <div class="who">{app.icon && <img src={app.icon} alt="" width="40" height="40" loading="lazy" />}<div><b>{app.name}</b><div class="mono">{app.kind} · {app.platforms}</div></div></div>
    <div class="btns">
      {app.store && <a class="btn" href={app.store} rel="noopener">App Store</a>}
      {app.cta && <a class="btn" href={app.cta.href}>{app.cta.label}</a>}
    </div>
  </div>
</Base>

<style>
  .st { display: inline-flex; gap: 7px; align-items: center; }
  .film { margin: 22px 0 0; }
  .film :global(.film-stage) { height: clamp(300px, 42vw, 500px); }
  .film :global(.film-stage .dev) { height: 72%; bottom: 14%; }
  .film :global(.film-stage .icon) { width: clamp(96px, 12vw, 140px); border-radius: 24%; }
  .film figcaption { margin: 10px 0 0; text-align: right; font-size: 13px; color: var(--muted); }
  .play { position: absolute; left: 22px; bottom: 20px; z-index: 2; display: inline-flex; align-items: center; gap: 12px; padding: 7px 16px 7px 7px; border-radius: 999px; border: 1px solid rgb(255 255 255 / .16); background: rgb(20 20 24 / .6); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); color: #eceae4; text-decoration: none; font: 500 14px/1.1 var(--f-sans); }
  .play i { width: 32px; height: 32px; border-radius: 50%; background: #eceae4; display: grid; place-items: center; }
  .play i::after { content: ""; border-left: 9px solid #0b0c0e; border-top: 6px solid transparent; border-bottom: 6px solid transparent; margin-left: 3px; }
  .play small { display: block; font-family: var(--f-mono); font-size: 10px; letter-spacing: .08em; color: #8a8984; margin-top: 2px; text-transform: uppercase; }
  .head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 40px; margin-top: 44px; align-items: start; }
  .kind { display: flex; gap: 9px; align-items: center; margin: 0; }
  .head h1 { margin: 10px 0 0; font-weight: 500; font-size: 34px; line-height: 1.1; letter-spacing: -0.035em; }
  .head .lede { margin-top: 12px; }
  .buy { margin-bottom: 18px; }
  .statement { margin: 0; font-weight: 500; font-size: clamp(22px, 1vw + 15px, 28px); line-height: 1.25; letter-spacing: -0.028em; max-width: 26em; text-wrap: balance; }
  .statement :global(em.s) { color: var(--a-text); }
  .two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px; margin-top: 26px; color: var(--dim); }
  .two p { margin: 0; max-width: 32em; }
  .panel-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 30px 26px; }
  .panel-list.n2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .panel-list h3 { margin: 0 0 6px; padding-bottom: 8px; border-bottom: 1px solid var(--line-2); font-family: var(--f-mono); font-size: 11px; letter-spacing: .1em; font-weight: 500; color: var(--ink); }
  .panel-list dl { margin: 0; }
  .panel-list dl > div { display: grid; grid-template-columns: 7.6em minmax(0, 1fr); gap: 10px; padding: 7px 0; border-bottom: 1px solid var(--line); font-size: 14px; line-height: 1.4; }
  .panel-list dl > div.solo { grid-template-columns: 1fr; }
  .panel-list dt { font-weight: 500; }
  .panel-list dt i { display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 7px; vertical-align: 1px; background: var(--f); }
  .panel-list dd { margin: 0; color: var(--dim); }
  .points { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 26px; }
  .points li { border-top: 1px solid var(--line-2); padding-top: 12px; }
  .points b { display: block; margin-top: 10px; font-weight: 500; font-size: 17px; letter-spacing: -0.015em; }
  .points p { margin: 6px 0 0; color: var(--dim); font-size: 15px; }
  .tool { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; padding: 22px 24px; border-radius: 16px; border: 1px solid var(--line-2); background: var(--card); text-decoration: none; }
  .tool h2 { margin-top: 6px; }
  .tool p:not(.mono) { margin: 6px 0 0; color: var(--dim); max-width: 36em; }
  .tool:hover { border-color: var(--ink); }
  .shots { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .shots.c3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .shots figure { margin: 0; }
  .shots :global(.stage) { aspect-ratio: 3 / 3.4; }
  .shots :global(.stage .dev) { height: 82%; bottom: 9%; }
  .shots figcaption { margin-top: 8px; font-size: 13px; color: var(--muted); }
  .manual { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 34px; align-items: start; }
  .chapters { list-style: none; margin: 0; padding: 0; columns: 2; column-gap: 26px; }
  .chapters li { break-inside: avoid; display: grid; grid-template-columns: 2.4em minmax(0, 1fr); padding: 6px 0; border-bottom: 1px solid var(--line); font-size: 14.5px; }
  .manual-card { border: 1px solid var(--line); border-radius: 16px; padding: 18px; background: var(--card); }
  .manual-card p:not(.mono) { margin: 8px 0 16px; color: var(--dim); font-size: 14.5px; }
  .manual-card .mono { margin: 0; }
  details { border-top: 1px solid var(--line); }
  details:last-of-type { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 16px; padding: 13px 0; font-weight: 500; letter-spacing: -0.01em; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; font-family: var(--f-mono); color: var(--muted); }
  details[open] summary::after { content: "\2212"; }
  details p { margin: 0 0 16px; color: var(--dim); max-width: 40em; }
  .end { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; margin-top: 70px; padding: 16px 18px; border-radius: 16px; border: 1px solid var(--line); background: var(--card); }
  .who { display: flex; align-items: center; gap: 12px; }
  .who img { width: 40px; height: 40px; border-radius: 10px; }
  .who b { font-weight: 500; }
  @media (max-width: 1000px) { .head, .manual { grid-template-columns: 1fr; gap: 26px; } .panel-list, .panel-list.n2 { grid-template-columns: repeat(2, minmax(0, 1fr)); } .shots { grid-template-columns: repeat(2, minmax(0, 1fr)); } .shots.c3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .two, .points, .panel-list, .panel-list.n2 { grid-template-columns: 1fr; gap: 18px; } .chapters { columns: 1; } .play { left: 12px; bottom: 12px; } .film figcaption { text-align: left; } .shots.c3 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
