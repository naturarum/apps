---
// One post in a list: date, kind and app on the left, title and excerpt, a small stage.
import type { Post } from '../lib/news';
import { appOf, fmtDate } from '../lib/news';
import Led from './Led.astro';
import Stage from './Stage.astro';
interface Props { post: Post }
const { post } = Astro.props;
const app = appOf(post);
---
<li data-k={post.kind}>
  <a class="post" href={post.href} style={app ? `--a: ${app.accent}` : undefined}>
    <div class="meta">
      <span class="mono">{fmtDate(post.date)}</span>
      <span class="mono k">{post.tag}</span>
      {app && <span class="mono app">{!app.external && <Led status={app.status} accent={app.accent} />}{app.name}</span>}
    </div>
    <div><h3>{post.title}</h3><p>{post.excerpt}</p></div>
    {app && <Stage visual={app.thumb} accent={app.accent} />}
  </a>
</li>
<style>
  .post { display: grid; grid-template-columns: 8.5em minmax(0, 1fr) 168px; gap: 26px; padding: 22px 0; border-top: 1px solid var(--line); text-decoration: none; align-items: start; }
  .meta { display: grid; gap: 6px; padding-top: 3px; align-content: start; }
  .k { color: var(--hl); }
  .app { display: inline-flex; gap: 7px; align-items: center; }
  h3 { margin: 0; font-weight: 500; font-size: 19px; line-height: 1.3; letter-spacing: -0.018em; }
  p { margin: 6px 0 0; color: var(--dim); font-size: 15px; max-width: 36em; }
  .post:hover h3 { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; text-decoration-color: var(--hl); }
  .post :global(.stage) { height: 104px; border-radius: 12px; }
  .post :global(.stage .dev) { padding: 3px; border-radius: 8px; }
  .post :global(.stage .dev img) { border-radius: 5px; }
  li[hidden] { display: none; }
  li:last-child .post { border-bottom: 1px solid var(--line); }
  @media (max-width: 640px) {
    .post { grid-template-columns: minmax(0, 1fr) 96px; gap: 8px 16px; }
    .meta { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 4px 12px; }
    .post :global(.stage) { height: 74px; grid-row: 2; grid-column: 2; }
  }
</style>
